{
  "schemaVersion": 1,
  "id": "omahorn",
  "name": "Omahorn",
  "version": "0.1.0",
  "author": "Allan Kayan",
  "license": "MIT",
  "homepage": "https://github.com/allankayan/omahorn",
  "repository": "https://github.com/allankayan/omahorn",
  "description": "Soundboard for Omarchy: play sounds into your microphone from a keyboard-first board or global hotkeys.",
  "kinds": [
    "service",
    "overlay",
    "bar-widget"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "overlay": "Board.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Omahorn",
    "description": "Opens the soundboard; shows what is playing",
    "category": "Audio",
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
