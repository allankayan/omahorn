#!/bin/bash

# Converts a sound pw-play cannot read (m4a, aac, webm, wma, ...) into an
# Opus file it can, so playback stays a single pw-play process.
#
#   omahorn-decode    stdin: {"input": "/path/sound.m4a", "output": "/cache/x.opus"}
#
# Does nothing when the output already exists. Writes through a temporary
# file, so an interrupted conversion never leaves a truncated sound behind.
# ffmpeg reads the sound on stdin, keeping its path out of world-readable argv.

set -euo pipefail
umask 077

request=$(cat)
input=$(jq -r '.input // ""' <<<"$request")
output=$(jq -r '.output // ""' <<<"$request")
[[ -n $input && $output == *.opus ]] || { echo "usage: omahorn-decode, with {\"input\", \"output\"} on stdin" >&2; exit 2; }

[[ -s $output ]] && exit 0
[[ -f $input && -r $input ]] || { echo "cannot read the sound file" >&2; exit 1; }
command -v ffmpeg >/dev/null || { echo "ffmpeg is required to play ${input##*.} files" >&2; exit 1; }

mkdir -p "$(dirname "$output")"
tmp="$(mktemp "${output%.opus}.XXXXXX.opus")"
trap 'rm -f "$tmp"' EXIT

nice -n 10 ffmpeg -nostdin -v error -y -i file:/dev/stdin -vn -map 0:a:0 -c:a libopus -b:a 160k "$tmp" <"$input"
mv -f "$tmp" "$output"
trap - EXIT
