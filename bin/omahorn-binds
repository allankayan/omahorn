#!/bin/bash

# Writes Omahorn's Hyprland binds file and applies it to the running
# compositor. Takes the request as JSON on stdin:
#
#   {"path": "/home/you/.local/state/omarchy/toggles/hypr/omahorn.lua",
#    "content": "-- Generated by Omahorn ...",   (null leaves the file as it is)
#    "code": "pcall(hl.unbind, ...) dofile(...)"}
#
# Sound names stay in the owner-only file, out of hyprctl's world-readable argv.

set -uo pipefail
umask 077

request=$(cat)
path=$(jq -r '.path // ""' <<<"$request" 2>/dev/null)
code=$(jq -r '.code // ""' <<<"$request" 2>/dev/null)
has_content=$(jq -r 'has("content") and .content != null' <<<"$request" 2>/dev/null)

[[ $path == /*.lua ]] || { echo "omahorn-binds: expected an absolute .lua path" >&2; exit 2; }

if [[ $has_content == "true" ]]; then
  mkdir -p "$(dirname "$path")" || exit 1
  # Not *.lua, so a Hyprland reload meanwhile never loads it.
  tmp=$(mktemp "$path.XXXXXX") || exit 1
  if ! jq -j '.content' <<<"$request" >"$tmp" || ! mv -f "$tmp" "$path"; then
    rm -f "$tmp"
    echo "omahorn-binds: could not write the binds file" >&2
    exit 1
  fi
fi

[[ -n $code ]] || exit 0
exec hyprctl eval "$code"
